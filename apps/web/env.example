# Notion is called from the Vite dev server (and Cloud Function), not the browser.
# Copy to .env: cp env.example .env

NOTION_API_KEY=secret_your_notion_api_key_here
NOTION_FEEDBACK_DB=your_notion_database_id_here

# reCAPTCHA v2 ("I'm not a robot") — https://www.google.com/recaptcha/admin
# Add localhost and kenya-locations.web.app as domains.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Existing Notion names still work:
# VITE_NOTION_API_KEY=
# VITE_NOTION_FEEDBACK_DB=
